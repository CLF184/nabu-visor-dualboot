     int previous = efi_log_file_enabled();
@@ -187,12 +190,28 @@ EFI_STATUS config_parse(config_t *config) {
     config->tail = NULL;
     config->entry_count = 0;
 
     CHAR16 *buf = read_text_file(CONFIG_FILE);
     if (!buf) {
+#ifdef NABU_EMBEDDED
+        /* nabu：读不到 ESP 配置时给出内置条目，避免退化为自动发现
+         * （自动发现的条目在安全启动下无法链式加载）。 */
+        efi_log(L"config: boot.conf not found - using built-in nabu entries");
+        boot_entry_t *a = config_add_entry(config, efi_strdup(L"Android"),
+            efi_strdup(L"\\EFI\\visor\\icons\\linux.png"),
+            efi_strdup(L"\\EFI\\visor\\NabuAndroid.efi"), NULL, NULL, NULL, 0, 0, 0);
+        if (a) a->nabu_action = NABU_ACTION_ANDROID;
+        boot_entry_t *w = config_add_entry(config, efi_strdup(L"Windows"),
+            efi_strdup(L"\\EFI\\visor\\icons\\windows.png"),
+            efi_strdup(L"\\EFI\\Microsoft\\Boot\\bootmgfw.efi"), NULL, NULL, NULL, 1, 0, 0);
+        if (w) w->nabu_action = NABU_ACTION_BDS;
+        snapshots_apply(config);
+        return EFI_SUCCESS;
+#else
         efi_log(L"config: boot.conf not found, auto-detecting boot entries");
         EFI_STATUS st = detect_entries(config);
         snapshots_apply(config);
         return st;
+#endif
     }
 
     UINTN max_lines = 1;
